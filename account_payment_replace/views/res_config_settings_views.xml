<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.payment.replace</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="account_batch_payment" position="after">
                <div
                    class="col-12 col-lg-6 o_setting_box"
                    id="account_payment_modify_mode"
                >
                    <div class="o_setting_right_pane">
                        <label for="account_payment_modify_mode" />
                        <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            aria-label="Values set here are company-specific."
                            groups="base.group_multi_company"
                            role="img"
                        />
                        <div class="text-muted">
                            Choose whether correcting a posted payment keeps the
                            same record or cancels it and creates a new one.
                        </div>
                        <field name="account_payment_modify_mode" />
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
