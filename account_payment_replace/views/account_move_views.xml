<odoo>
    <record id="view_move_form_payment_replace" model="ir.ui.view">
        <field name="name">account.move.form.payment.replace</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <field name="account_payment_modify_mode" invisible="1" />
            </xpath>
            <xpath
                expr="//button[@name='action_register_payment'][@id='account_invoice_payment_btn']"
                position="after"
            >
                <button
                    name="action_replace_payment"
                    id="account_invoice_edit_payment_btn"
                    type="object"
                    string="Edit Payment"
                    class="btn-secondary"
                    groups="account_payment_replace.group_account_payment_replace"
                    attrs="{'invisible': ['|', '|', '|', ('state', '!=', 'posted'), ('payment_state', 'not in', ('paid', 'partial', 'in_payment')), ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')), ('account_payment_modify_mode', '!=', 'edit')]}"
                    data-hotkey="shift+r"
                />
                <button
                    name="action_replace_payment"
                    id="account_invoice_replace_payment_btn"
                    type="object"
                    string="Replace Payment"
                    class="btn-secondary"
                    groups="account_payment_replace.group_account_payment_replace"
                    attrs="{'invisible': ['|', '|', '|', ('state', '!=', 'posted'), ('payment_state', 'not in', ('paid', 'partial', 'in_payment')), ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')), ('account_payment_modify_mode', '!=', 'replace')]}"
                    data-hotkey="shift+r"
                />
            </xpath>
        </field>
    </record>

    <record id="action_account_move_replace_payment" model="ir.actions.server">
        <field name="name">Modify Payment</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('group_account_payment_replace'))]" />
        <field name="code">
if len(records) != 1:
    raise UserError("Select exactly one invoice or bill to modify its payment.")
action = records.action_replace_payment()
        </field>
    </record>
</odoo>
